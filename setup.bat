@echo off
setlocal EnableDelayedExpansion

echo.
echo  =============================================
echo   Law RAG  ^|  Setup
echo  =============================================
echo.

REM ── 1. Check Docker ──────────────────────────────────────────────────────────
docker info >nul 2>&1
if %errorlevel% neq 0 (
    echo  ERROR: Docker Desktop is not running.
    echo.
    echo  Please open Docker Desktop, wait for it to finish starting,
    echo  then run this script again.
    echo.
    pause
    exit /b 1
)
echo  [OK] Docker is running

REM ── 2. Create .env if it does not exist ──────────────────────────────────────
if exist .env (
    echo  [OK] .env found — using existing configuration
) else (
    echo.
    echo  Let's configure your installation.
    echo  You will need an OpenAI API key.
    echo  Get one at: https://platform.openai.com/api-keys
    echo.

    :ask_key
    set /p OPENAI_KEY=" OpenAI API key (starts with sk-): "
    if "!OPENAI_KEY!"=="" (
        echo  A key is required — please try again.
        goto :ask_key
    )

    echo.
    set /p ADMIN_EMAIL=" Admin login email  [admin@lawfirm.local]: "
    if "!ADMIN_EMAIL!"=="" set ADMIN_EMAIL=admin@lawfirm.local

    set /p ADMIN_PASSWORD=" Admin password     [changeme]: "
    if "!ADMIN_PASSWORD!"=="" set ADMIN_PASSWORD=changeme

    REM Generate a random SECRET_KEY using PowerShell
    for /f "delims=" %%i in ('powershell -NoProfile -Command "[Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"') do set SECRET_KEY=%%i

    (
        echo # Law RAG — Configuration
        echo # Generated by setup.bat. Keep this file private.
        echo.
        echo OPENAI_API_KEY=!OPENAI_KEY!
        echo SECRET_KEY=!SECRET_KEY!
        echo ADMIN_EMAIL=!ADMIN_EMAIL!
        echo ADMIN_PASSWORD=!ADMIN_PASSWORD!
    ) > .env

    echo.
    echo  [OK] Configuration saved to .env
)

REM ── 3. Build and start ───────────────────────────────────────────────────────
echo.
echo  Starting Law RAG...
echo  (First launch builds Docker images — this takes a few minutes)
echo.
docker compose up -d --build

REM ── 4. Wait for healthy ──────────────────────────────────────────────────────
echo.
echo  Waiting for the app to be ready...
:health_loop
timeout /t 3 /nobreak >nul
curl -sf http://localhost:8000/health >nul 2>&1
if %errorlevel% neq 0 goto :health_loop

REM ── 5. Done ──────────────────────────────────────────────────────────────────
echo.
echo  =============================================
echo   Law RAG is ready!
echo.
echo   Open in your browser: http://localhost:5173
echo.
echo   Login credentials are in your .env file.
echo   Default: admin@lawfirm.local / changeme
echo  =============================================
echo.
start http://localhost:5173
pause
