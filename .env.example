# ================================================================
#  Law RAG — Configuration Template
#
#  Option A (recommended): run setup.bat (Windows) or ./setup.sh
#  (Mac/Linux) and this file is filled in automatically.
#
#  Option B (manual): copy this file to .env and fill in the
#  two required values below.
# ================================================================

# ── REQUIRED ─────────────────────────────────────────────────────
# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# A long random secret used to sign login tokens.
# Generate one with: openssl rand -base64 32
SECRET_KEY=

# ── ADMIN ACCOUNT ────────────────────────────────────────────────
# Credentials for the first admin user created on first startup.
# Change the password before deploying to production.
ADMIN_EMAIL=admin@lawfirm.local
ADMIN_PASSWORD=changeme

# ── OPTIONAL OVERRIDES ───────────────────────────────────────────
# These have sensible defaults — only set them if you need to change them.

# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
# LOG_LEVEL=INFO
