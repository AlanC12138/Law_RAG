# ================================================================
#  Law RAG — Configuration Template
#
#  Option A (recommended): run setup.bat (Windows) or ./setup.sh
#  (Mac/Linux) and this file is filled in automatically.
#
#  Option B (manual): copy this file to .env and fill in your values.
# ================================================================

# ── REQUIRED ─────────────────────────────────────────────────────
# Your OpenAI API key — get one at https://platform.openai.com/api-keys
# Not needed if you set LLM_PROVIDER=ollama below.
OPENAI_API_KEY=sk-...

# A long random secret used to sign login tokens.
# Generate one with: openssl rand -base64 32
SECRET_KEY=

# ── ADMIN ACCOUNT ────────────────────────────────────────────────
# Credentials for the first admin user created on first startup.
# Change the password before deploying to production.
ADMIN_EMAIL=admin@lawfirm.local
ADMIN_PASSWORD=changeme

# ── DATABASE ─────────────────────────────────────────────────────
# Postgres is the default — docker-compose starts a postgres service and
# points the backend at it automatically. Change the password below
# before deploying anywhere reachable outside your own machine.
POSTGRES_USER=law_rag
POSTGRES_PASSWORD=
POSTGRES_DB=law_rag

# To use SQLite instead (no separate database container — handy for
# quick local hacking), set this and Postgres will be ignored:
# DATABASE_URL=sqlite+aiosqlite:///./data/law_rag.db

# ── LLM PROVIDER ─────────────────────────────────────────────────
# "openai"  → use OpenAI API (default, requires OPENAI_API_KEY above)
# "ollama"  → use a local Ollama instance (no OpenAI key needed)
# LLM_PROVIDER=openai

# ── OLLAMA SETTINGS (only needed when LLM_PROVIDER=ollama) ───────
# Uncomment the ollama service in docker-compose.yml, then:
#   docker compose exec ollama ollama pull llama3.2
#   docker compose exec ollama ollama pull nomic-embed-text
#
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_LLM_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768   # must match the embedding model above

# ── OPTIONAL OVERRIDES ───────────────────────────────────────────
# These have sensible defaults — only set them if you need to change them.

# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
# LOG_LEVEL=INFO
