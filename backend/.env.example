# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Authentication
SECRET_KEY=change-me-to-a-long-random-string-min-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# SQLite is the default here for running the backend directly (no Docker).
# Running via `docker compose up` instead uses Postgres automatically —
# see the root .env.example for POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# To point this bare backend at a Postgres instance instead, set:
# DATABASE_URL=postgresql+asyncpg://law_rag:<password>@localhost:5432/law_rag
DATABASE_URL=sqlite+aiosqlite:///./data/law_rag.db

# Qdrant Vector Store
QDRANT_PATH=./data/qdrant_storage
QDRANT_API_KEY=

# Document Ingestion
WATCH_FOLDER=./data/watch
DATA_DIR=./data
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Seed admin (created on first run if no users exist — change immediately)
ADMIN_EMAIL=admin@lawfirm.local
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin Partner

# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
